<?xml version="1.0" encoding="UTF-8"?>
<project name="SmartLoan" default="deploy" basedir=".">
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build/classes"/>
    <property name="web.dir" value="WebContent"/>
    <property name="dist.dir" value="dist"/>
    <property name="lib.dir" value="lib"/>
    <property name="tomcat.home" value="d:/godrej3/apache-tomcat-10.1.28"/>
    
    <path id="classpath">
        <fileset dir="${tomcat.home}/lib">
            <include name="*.jar"/>
        </fileset>
        <fileset dir="${lib.dir}" erroronmissingdir="false">
            <include name="*.jar"/>
        </fileset>
    </path>

    <target name="clean">
        <delete dir="build"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="init">
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" destdir="${build.dir}" classpathref="classpath" includeantruntime="false"/>
    </target>

    <target name="war" depends="compile">
        <war destfile="${dist.dir}/smart-loan.war" webxml="${web.dir}/WEB-INF/web.xml">
            <fileset dir="${web.dir}"/>
            <classes dir="${build.dir}"/>
            <lib dir="${lib.dir}" erroronmissingdir="false"/>
        </war>
    </target>

    <target name="deploy" depends="war">
        <copy file="${dist.dir}/smart-loan.war" todir="${tomcat.home}/webapps"/>
    </target>
</project>
